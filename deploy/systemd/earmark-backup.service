[Unit]
Description=Earmark backup — dump, encrypt, push to connorpc
After=docker.service tailscaled.service
Wants=docker.service

[Service]
Type=oneshot
User=connor
Group=connor
ExecStart=/home/connor/apps/earmark/deploy/earmark-backup.sh
# The script decides for itself whether a skipped push is a fault; it exits 0
# when connorpc is simply off, so a non-zero status here is always real.
StandardOutput=journal
StandardError=journal
