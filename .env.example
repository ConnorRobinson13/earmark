# Anthropic API key — powers transaction categorization. Optional; the app
# runs without it (you just categorize manually). Get one at console.anthropic.com
ANTHROPIC_API_KEY=

# Plaid credentials — optional. Without them, bank sync is disabled and you
# add transactions manually. Sign up at dashboard.plaid.com. Start in sandbox.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Bearer token that gates the MCP server ("talk to your money"). Leave empty to
# run the MCP server open — LOCAL ONLY, never tunnel it open to the internet.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Postgres password. Only used by docker-compose.prod.yml, which refuses to
# start without it — the dev stack keeps its throwaway `budget` default. Set it
# once when the production database is first created; changing it later means
# an ALTER USER plus keeping DATABASE_URL in step.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Timezone for the 06:00 Plaid sync. Defaults to America/Chicago.
TZ=America/Chicago

# --- Deployment (hermes) -----------------------------------------------------
# Read by deploy/lib.sh. Kept here rather than defaulted in the scripts because
# this repo is public and the app has no login of its own — the tailnet is the
# access control, so the hostname and the peer address are part of the security
# posture, not just configuration.
EARMARK_URL=https://your-host.your-tailnet.ts.net

# Tailnet IP of the machine that receives pushed backups. Empty means the
# backup script keeps a local copy only and does not attempt a push.
EARMARK_PEER_HOST=

# Unprivileged account on that machine the push lands as.
EARMARK_PEER_USER=earmarkbk
