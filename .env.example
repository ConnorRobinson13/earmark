# Anthropic API key — powers transaction categorization. Optional; the app
# runs without it (you just categorize manually). Get one at console.anthropic.com
ANTHROPIC_API_KEY=

# Plaid credentials — optional. Without them, bank sync is disabled and you
# add transactions manually. Sign up at dashboard.plaid.com. Start in sandbox.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Bearer token that gates the MCP server ("talk to your money"). Leave empty to
# run the MCP server open — LOCAL ONLY, never tunnel it open to the internet.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Postgres password. Only used by docker-compose.prod.yml, which refuses to
# start without it — the dev stack keeps its throwaway `budget` default. Set it
# once when the production database is first created; changing it later means
# an ALTER USER plus keeping DATABASE_URL in step.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Timezone for the 06:00 Plaid sync. Defaults to America/Chicago.
TZ=America/Chicago
